# StreetSense production environment template.
#
# Copy to .env.prod, fill in real values, and never commit the
# populated file. docker-compose.prod.yml reads from --env-file.

# --- Public-facing config ------------------------------------------------
PUBLIC_HOSTNAME=streetsense.example.com
PUBLIC_ORIGIN=https://streetsense.example.com
ACME_EMAIL=ops@example.com

# --- Postgres -----------------------------------------------------------
POSTGRES_DB=streetsense
POSTGRES_USER=streetsense
POSTGRES_PASSWORD=change-me-to-a-strong-random-string

# Password for the least-privilege app role used by pg_tileserv and
# the FastAPI process. Separate from POSTGRES_PASSWORD (the owner role).
APP_DB_PASSWORD=change-me-to-a-different-strong-random-string

# --- MinIO --------------------------------------------------------------
MINIO_ROOT_USER=streetsense
MINIO_ROOT_PASSWORD=change-me-to-a-strong-random-string

# --- Basic auth ---------------------------------------------------------
# Single shared credential gating the whole instance. Format:
#   "user:bcrypt-hash"
# Generate with:
#   python -c "import bcrypt; print('admin:' + bcrypt.hashpw(b'your-password', bcrypt.gensalt(rounds=12)).decode())"
STREETSENSE_BASIC_AUTH=admin:$2b$12$placeholder.placeholder.placeholder.placeholder.placeholder.

# --- Image tag ---------------------------------------------------------
# Set to a git SHA or release tag in CI; defaults to 'latest' for
# local-on-VPS deploys.
IMAGE_TAG=latest
