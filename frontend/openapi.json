{
  "openapi": "3.1.0",
  "info": {
    "title": "StreetSense API",
    "version": "2.0.0"
  },
  "paths": {
    "/segments/{segment_id}": {
      "get": {
        "tags": [
          "segments"
        ],
        "summary": "Get Segment",
        "description": "Return the per-segment detail payload.\n\nPer-sub-score `is_stub` flags expose which scorers are real:\nglare flips to false in Phase 2; the other three remain true.",
        "operationId": "get_segment_segments__segment_id__get",
        "parameters": [
          {
            "name": "segment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Segment Id"
            }
          },
          {
            "name": "t",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional ISO-8601 UTC instant. Snaps to the nearest persisted hourly sample in segment_scores. Omitted \u21d2 most recent score row.",
              "title": "T"
            },
            "description": "Optional ISO-8601 UTC instant. Snaps to the nearest persisted hourly sample in segment_scores. Omitted \u21d2 most recent score row."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/freshness": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Freshness",
        "operationId": "freshness_admin_freshness_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FreshnessReport"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FreshnessEntry": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "last_ingested_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Ingested At"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "name",
          "last_ingested_at"
        ],
        "title": "FreshnessEntry",
        "description": "One row of `/admin/freshness`."
      },
      "FreshnessReport": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/FreshnessEntry"
            },
            "type": "array",
            "title": "Sources"
          },
          "server_time": {
            "type": "string",
            "format": "date-time",
            "title": "Server Time"
          }
        },
        "type": "object",
        "required": [
          "sources",
          "server_time"
        ],
        "title": "FreshnessReport",
        "description": "Response shape for `/admin/freshness`.\n\nA *list* (wrapped) \u2014 not a single object \u2014 so Phase 3 can register\nmultiple data sources (imagery providers, incident feeds) without a\nbreaking API change."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SegmentDetail": {
        "properties": {
          "segment_id": {
            "type": "string",
            "format": "uuid",
            "title": "Segment Id"
          },
          "osm_way_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Osm Way Id"
          },
          "composite_risk": {
            "type": "number",
            "title": "Composite Risk",
            "description": "Composite risk in [0, 1]. Phase 2: equal to the glare value (the only real sub-score). Phase 4 ships the weighted composite."
          },
          "sub_scores": {
            "$ref": "#/components/schemas/SubScores"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "description": "Confidence in [0, 1]. Phase 2: glare's confidence (placeholder 1.0)."
          },
          "attrs": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Attrs",
            "description": "Selected OSM attributes."
          }
        },
        "type": "object",
        "required": [
          "segment_id",
          "osm_way_id",
          "composite_risk",
          "sub_scores",
          "confidence"
        ],
        "title": "SegmentDetail",
        "description": "Per-segment detail payload returned by GET /segments/{id}.\n\nPhase 2: top-level `risk_stub` flag removed; per-sub-score\n`is_stub` flags inside `sub_scores` replace it."
      },
      "SubScore": {
        "properties": {
          "value": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Value",
            "description": "Risk in [0, 1]. Higher = worse."
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "is_stub": {
            "type": "boolean",
            "title": "Is Stub",
            "description": "True if the value is a stub (no real scorer for this sub-score in this phase). Consumers must check this \u2014 Phase 2 carries is_stub=false only for glare_exposure."
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Scorer-specific provenance (e.g., sun_azimuth_deg / sun_elevation_deg for glare). Safe to add fields without breaking consumers."
          }
        },
        "type": "object",
        "required": [
          "value",
          "confidence",
          "is_stub"
        ],
        "title": "SubScore",
        "description": "One sub-score's per-segment, per-timestamp output as exposed at\nthe API boundary.\n\nMirrors `scoring.interface.SubScoreResult` but lives in `api/` so\nthe API can evolve its serialization independently if needed."
      },
      "SubScores": {
        "properties": {
          "lane_marking_quality": {
            "$ref": "#/components/schemas/SubScore"
          },
          "glare_exposure": {
            "$ref": "#/components/schemas/SubScore"
          },
          "junction_complexity": {
            "$ref": "#/components/schemas/SubScore"
          },
          "historical_correlation": {
            "$ref": "#/components/schemas/SubScore"
          }
        },
        "type": "object",
        "required": [
          "lane_marking_quality",
          "glare_exposure",
          "junction_complexity",
          "historical_correlation"
        ],
        "title": "SubScores",
        "description": "Four sub-scores carried in every composite-risk response.\n\nPhase 1 stub values. Phase 2 fills `glare_exposure`; Phase 3 fills\n`lane_marking_quality` and `historical_correlation`; Phase 4 fills the\nweighted composite. `junction_complexity` is derived from OSM topology\nin Phase 3+."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}