# Copy to .env (gitignored) and fill in for local dev. CI provides these via
# secrets / environment, not via this file.

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streetsense
POSTGRES_USER=streetsense
POSTGRES_PASSWORD=streetsense

# DSN built from the above. Alembic and the API read this.
DATABASE_URL=postgresql+psycopg://streetsense:streetsense@localhost:5432/streetsense

# Application role created in migration 0001. Used by FastAPI for runtime
# queries — UPDATE/DELETE on append-only tables is revoked from this role.
POSTGRES_APP_USER=streetsense_app
POSTGRES_APP_PASSWORD=streetsense_app

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
