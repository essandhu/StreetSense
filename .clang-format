# StreetSense C++ formatting — Google style as the base with project deltas.
#
# Applies to: scoring/propagator/ (the only C++ tree in the repo).
# Enforced in CI by `clang-format --dry-run --Werror` on every PR touching
# scoring/propagator/**.
#
# Refs:
#   - conductor/code_styleguides/cpp.md
#   - CLAUDE.md §"C++"
---
Language: Cpp
BasedOnStyle: Google

# Project deltas (per plan.md Task 4.1.9):
ColumnLimit: 100
AccessModifierOffset: -2
AllowShortFunctionsOnASingleLine: InlineOnly
PointerAlignment: Left

# Reasonable defaults reinforced (Google sets most of these already, but
# pinning them locally makes the file self-documenting):
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
NamespaceIndentation: None
DerivePointerAlignment: false
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
ReflowComments: true
SeparateDefinitionBlocks: Always
SpaceBeforeCpp11BracedList: false
Standard: c++17
...
